<Window x:Class="VolumeHUD.Views.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volu"
        Height="260" Width="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Opacity="0">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Classic macOS Frosted Translucent Volume HUD -->
        <Border x:Name="HudBorder"
                Width="200" Height="200"
                CornerRadius="26"
                Background="#D4DFE5EC"
                SnapsToDevicePixels="True">

            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.25" Direction="270" />
            </Border.Effect>

            <Grid Margin="0">
                <!-- Speaker Icon Area (Classic Dark Icon: #1C1E24) -->
                <Canvas Width="120" Height="86"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,38,0,0">
                    
                    <!-- Speaker Body -->
                    <Path x:Name="SpeakerBody"
                          Data="M 8,26 H 25 L 53,7 C 55,5.5 57,7 57,9 V 77 C 57,79 55,80.5 53,79 L 25,60 H 8 C 5.8,60 4,58.2 4,56 V 30 C 4,27.8 5.8,26 8,26 Z"
                          Fill="#1C1E24"
                          Stroke="#1C1E24"
                          StrokeThickness="1"
                          StrokeLineJoin="Round" />

                    <!-- Sound Wave 1 (Inner) -->
                    <Path x:Name="Wave1"
                          Data="M 71,26 A 24,24 0 0 1 71,60"
                          Stroke="#1C1E24"
                          StrokeThickness="4.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />

                    <!-- Sound Wave 2 (Middle) -->
                    <Path x:Name="Wave2"
                          Data="M 88,21 A 38,38 0 0 1 88,65"
                          Stroke="#1C1E24"
                          StrokeThickness="4.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />

                    <!-- Sound Wave 3 (Outer) -->
                    <Path x:Name="Wave3"
                          Data="M 105,16 A 52,52 0 0 1 105,70"
                          Stroke="#1C1E24"
                          StrokeThickness="4.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />

                    <!-- Classic macOS Mute Slash: diagonal line cutting across speaker and waves -->
                    <Line x:Name="MuteSlash"
                          X1="4" Y1="14" X2="118" Y2="72"
                          Stroke="#1C1E24"
                          StrokeThickness="4.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Visibility="Collapsed" />
                </Canvas>

                <!-- Continuous rectangular bar with 16 segments (Dark track with white filled blocks) -->
                <Border Width="144" Height="7"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,30"
                        Background="#1C1E24"
                        CornerRadius="1"
                        SnapsToDevicePixels="True">
                    <UniformGrid x:Name="SegmentsGrid"
                                 Columns="16"
                                 Rows="1"
                                 SnapsToDevicePixels="True">
                    </UniformGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
